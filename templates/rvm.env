# infra/rvm.env — how the fleet runs THIS project. Sourced as shell by
# bootstrap/wrapper/worker on the instance, and by `rvm launch` locally.
# Every value has a working default in research-vm-infra/lib/common.sh;
# set only what differs.

# --- environment -----------------------------------------------------------
# Pin the interpreter. uv fetches it at boot if the image does not have it,
# so this costs a download rather than an AMI rebuild. Match whatever CI
# runs: a version skew between CI and the instance means tests that pass in
# one and fail in the other, which burns a session before anyone suspects
# the interpreter.
RVM_PYTHON="3.12"
# The command that installs this project's dependencies, run from the repo
# root inside a fresh venv. Its exact text is part of the env-cache key, so
# editing it forces a rebuild — which is the point.
RVM_ENV_INSTALL="pip install -e '.[dev]'"

# Files whose contents define the environment. Change any of them and the
# next boot builds a new venv and publishes it; leave them alone and every
# boot restores in seconds. Missing files are skipped.
RVM_ENV_FILES="pyproject.toml requirements.txt uv.lock"

# --- what the agent does ---------------------------------------------------
RVM_PROMPT_FILE="infra/prompt.md"
RVM_BRANCH="main"
RVM_CI_GATE=1                       # 0 for a repo with no GitHub Actions

# --- sweeps ----------------------------------------------------------------
# Run by each worker from the repo root, with {worker_id} substituted.
# Leave empty if this project never fans out.
RVM_WORKER_CMD=""
# e.g. RVM_WORKER_CMD="python scripts/sweep.py --manifest sweep_manifest.json --worker-id {worker_id}"

# --- machines --------------------------------------------------------------
RVM_INSTANCE_TYPE="t4g.small"       # arm64; the env cache is per-arch
RVM_HARD_CAP_HOURS=4                # orchestrator stop-after
RVM_WORKER_HOURS=3                  # per-cell stop-after

# --- shared data caches ----------------------------------------------------
# space-separated name:destination pairs, synced down at boot from
# s3://<bucket>/caches/<name>/. Populate with `rvm cache push <name> <path>`.
RVM_CACHE_PATHS=""
# e.g. RVM_CACHE_PATHS="huggingface:/home/ubuntu/.cache/huggingface"
